[Unit]
Description=acme companion
Requires=docker.service nginx-proxy.service
After=docker.service nginx-proxy.service

[Service]
ExecStartPre=/bin/sleep 1
ExecStartPre=/usr/bin/docker pull nginxproxy/acme-companion:2.6.0
ExecStart=/usr/bin/docker run \
  --name nginx-proxy-acme \
  --restart=always \
  --network=webservers \
  --volumes-from nginx-proxy \
  --volume /var/run/docker.sock:/var/run/docker.sock:ro \
  --volume acme:/etc/acme.sh \
  --env-file {{ nginx_proxy_acme_env_file | default('/service/nginx-proxy/acme-companion.env') }} \
{% if nginx_proxy_acme_challenge | default('HTTP-01') == 'DNS-01' %}
  --volume {{ nginx_proxy_nsupdate_key_path | default('/service/nginx-proxy/nsupdate.key') }}:/etc/acme.sh/nsupdate.key:ro \
{% endif %}
  nginxproxy/acme-companion
ExecStop=/usr/bin/docker stop nginx-proxy-acme
ExecStopPost=/usr/bin/docker rm -f nginx-proxy-acme
ExecReload=/usr/bin/docker restart nginx-proxy-acme

[Install]
WantedBy=multi-user.target
