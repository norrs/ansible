[Unit]
Description=nginx proxy
Requires=docker.service
After=docker.service

[Service]
ExecStartPre=/bin/sleep 1
ExecStartPre=/usr/bin/docker pull {{ nginx_proxy_pull_image | default('nginxproxy/nginx-proxy:1.7') }}
ExecStart=/usr/bin/docker run \
  --name nginx-proxy \
  --restart=always \
  --network=webservers \
  -e TRUST_DOWNSTREAM_PROXY=false \
  --publish 80:80 \
  --publish 443:443 \
  --volume certs:/etc/nginx/certs \
{% if nginx_proxy_vhost_dir is defined %}
  --volume {{ nginx_proxy_vhost_dir }}:/etc/nginx/vhost.d \
{% else %}
  --volume vhost:/etc/nginx/vhost.d \
{% endif %}
  --volume html:/usr/share/nginx/html \
  --volume /var/run/docker.sock:/tmp/docker.sock:ro \
  {{ nginx_proxy_image | default('nginxproxy/nginx-proxy') }}
{% if nginx_proxy_additional_internal_networks | default([]) | length > 0 %}
ExecStartPost={{ nginx_proxy_service_dir | default('/service/nginx-proxy') }}/connect-internal-networks.sh
{% endif %}
ExecStop=/usr/bin/docker stop nginx-proxy
ExecStopPost=/usr/bin/docker rm -f nginx-proxy
ExecReload=/usr/bin/docker restart nginx-proxy

[Install]
WantedBy=multi-user.target
