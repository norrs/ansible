DEFAULT_EMAIL={{ DEFAULT_EMAIL }}
ACME_CHALLENGE={{ nginx_proxy_acme_challenge | default('HTTP-01') }}
{% if nginx_proxy_acme_challenge | default('HTTP-01') == 'DNS-01' %}
# nginx_proxy_nsupdate_server and nginx_proxy_nsupdate_zone are host/private values;
# see private/group_vars/dalaran.yaml.
ACMESH_DNS_API_CONFIG={"DNS_API":"dns_nsupdate","NSUPDATE_SERVER":"{{ nginx_proxy_nsupdate_server | mandatory }}","NSUPDATE_SERVER_PORT":"{{ nginx_proxy_nsupdate_server_port | default('53') }}","NSUPDATE_KEY":"/etc/acme.sh/nsupdate.key","NSUPDATE_ZONE":"{{ nginx_proxy_nsupdate_zone | mandatory }}","DNS_SLEEP":"{{ nginx_proxy_dns_sleep | default('60') }}"}
{% endif %}
