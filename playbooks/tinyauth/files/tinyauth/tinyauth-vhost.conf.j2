location = /sso-logout {
    default_type text/html;
    add_header Cache-Control "no-store" always;
    return 200 '<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="refresh" content="3; url=https://{{ pocket_id_hostname }}/api/oidc/end-session">
  <title>Signing out</title>
  <style>
    body {
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-items: center;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: #111827;
      color: #f9fafb;
    }
    main {
      width: min(28rem, calc(100vw - 2rem));
      line-height: 1.5;
    }
    a {
      color: #93c5fd;
    }
  </style>
</head>
<body>
  <main>
    <h1>Signing out</h1>
    <p>Ending the TinyAuth session, then opening Pocket ID sign-out.</p>
    <p><a href="https://{{ pocket_id_hostname }}/api/oidc/end-session">Continue to Pocket ID sign-out</a></p>
  </main>
  <script>
    fetch("/api/user/logout", {
      method: "POST",
      credentials: "include"
    }).finally(function () {
      window.location.replace("https://{{ pocket_id_hostname }}/api/oidc/end-session");
    });
  </script>
</body>
</html>';
}
