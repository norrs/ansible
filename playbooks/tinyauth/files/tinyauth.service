[Unit]
Description=tinyauth service
Requires=docker.service nginx-proxy.service acme-companion.service
After=docker.service nginx-proxy.service acme-companion.service

[Service]
Restart=always
WorkingDirectory=/service/tinyauth

ExecStartPre=/bin/sleep 1
ExecStart=/usr/bin/docker compose -f compose.yaml up --force-recreate
ExecStop=/usr/bin/docker compose -f compose.yaml down

[Install]
WantedBy=multi-user.target
