{% macro tinyauth_csv(value) -%}
{%- if value is string -%}
{{- value -}}
{%- elif value is sequence -%}
{{- value | join(',') -}}
{%- else -%}
{{- value -}}
{%- endif -%}
{%- endmacro %}
TINYAUTH_APPURL=https://{{ tinyauth_hostname }}
TINYAUTH_DATABASE_DRIVER=sqlite
TINYAUTH_DATABASE_PATH=/data/tinyauth.db
TINYAUTH_RESOURCES_PATH=/resources
TINYAUTH_ANALYTICS_ENABLED=false
TINYAUTH_AUTH_SECURECOOKIE=true
TINYAUTH_AUTH_TRUSTEDPROXIES={{ tinyauth_trusted_proxies | default('172.16.0.0/12') }}
TINYAUTH_AUTH_ACLS_POLICY={{ tinyauth_auth_acls_policy | default('allow') }}
TINYAUTH_OIDC_PRIVATEKEYPATH=/oidc/private.pem
TINYAUTH_OIDC_PUBLICKEYPATH=/oidc/public.pem
{% if tinyauth_pocket_id_client_id and tinyauth_pocket_id_client_secret %}
TINYAUTH_OAUTH_AUTOREDIRECT=pocketid
TINYAUTH_OAUTH_PROVIDERS_POCKETID_CLIENTID={{ tinyauth_pocket_id_client_id }}
TINYAUTH_OAUTH_PROVIDERS_POCKETID_CLIENTSECRET={{ tinyauth_pocket_id_client_secret }}
TINYAUTH_OAUTH_PROVIDERS_POCKETID_AUTHURL=https://{{ pocket_id_hostname }}/authorize
TINYAUTH_OAUTH_PROVIDERS_POCKETID_TOKENURL=https://{{ pocket_id_hostname }}/api/oidc/token
TINYAUTH_OAUTH_PROVIDERS_POCKETID_USERINFOURL=https://{{ pocket_id_hostname }}/api/oidc/userinfo
TINYAUTH_OAUTH_PROVIDERS_POCKETID_REDIRECTURL=https://{{ tinyauth_hostname }}/api/oauth/callback/pocketid
TINYAUTH_OAUTH_PROVIDERS_POCKETID_LOGOUTURL=https://{{ pocket_id_hostname }}/api/oidc/end-session
TINYAUTH_OAUTH_PROVIDERS_POCKETID_SCOPES=openid email profile groups
TINYAUTH_OAUTH_PROVIDERS_POCKETID_NAME=Pocket ID
{% endif %}
{% if tinyauth_effective_oauth_whitelist %}
TINYAUTH_OAUTH_WHITELIST={{ tinyauth_effective_oauth_whitelist }}
{% endif %}
{% for client in tinyauth_oidc_clients | default([]) %}
{% set tinyauth_client_env_id = client.id | upper | regex_replace('[^A-Z0-9]', '') %}
{% set tinyauth_client_credentials = tinyauth_oidc_client_credentials[client.id] %}
{% if tinyauth_client_credentials.client_id and tinyauth_client_credentials.client_secret %}
TINYAUTH_OIDC_CLIENTS_{{ tinyauth_client_env_id }}_CLIENTID={{ tinyauth_client_credentials.client_id }}
TINYAUTH_OIDC_CLIENTS_{{ tinyauth_client_env_id }}_CLIENTSECRET={{ tinyauth_client_credentials.client_secret }}
TINYAUTH_OIDC_CLIENTS_{{ tinyauth_client_env_id }}_TRUSTEDREDIRECTURIS={{ tinyauth_csv(client.trusted_redirect_uris) }}
TINYAUTH_OIDC_CLIENTS_{{ tinyauth_client_env_id }}_NAME={{ client.name }}
{% endif %}
{% endfor %}
{% for app in tinyauth_apps | default([]) %}
{% set tinyauth_app_env_id = app.id | upper | regex_replace('[^A-Z0-9]', '') %}
{% if app.domain | default('') %}
TINYAUTH_APPS_{{ tinyauth_app_env_id }}_CONFIG_DOMAIN={{ app.domain }}
{% endif %}
{% if app.oauth_whitelist | default('') %}
TINYAUTH_APPS_{{ tinyauth_app_env_id }}_OAUTH_WHITELIST={{ tinyauth_csv(app.oauth_whitelist) }}
{% endif %}
{% if app.oauth_groups | default('') %}
TINYAUTH_APPS_{{ tinyauth_app_env_id }}_OAUTH_GROUPS={{ tinyauth_csv(app.oauth_groups) }}
{% endif %}
{% if app.users_allow | default('') %}
TINYAUTH_APPS_{{ tinyauth_app_env_id }}_USERS_ALLOW={{ tinyauth_csv(app.users_allow) }}
{% endif %}
{% if app.users_block | default('') %}
TINYAUTH_APPS_{{ tinyauth_app_env_id }}_USERS_BLOCK={{ tinyauth_csv(app.users_block) }}
{% endif %}
{% if app.ip_allow | default('') %}
TINYAUTH_APPS_{{ tinyauth_app_env_id }}_IP_ALLOW={{ tinyauth_csv(app.ip_allow) }}
{% endif %}
{% if app.ip_block | default('') %}
TINYAUTH_APPS_{{ tinyauth_app_env_id }}_IP_BLOCK={{ tinyauth_csv(app.ip_block) }}
{% endif %}
{% if app.ip_bypass | default('') %}
TINYAUTH_APPS_{{ tinyauth_app_env_id }}_IP_BYPASS={{ tinyauth_csv(app.ip_bypass) }}
{% endif %}
{% if app.path_allow | default('') %}
TINYAUTH_APPS_{{ tinyauth_app_env_id }}_PATH_ALLOW={{ tinyauth_csv(app.path_allow) }}
{% endif %}
{% if app.path_block | default('') %}
TINYAUTH_APPS_{{ tinyauth_app_env_id }}_PATH_BLOCK={{ tinyauth_csv(app.path_block) }}
{% endif %}
{% if app.ldap_groups | default('') %}
TINYAUTH_APPS_{{ tinyauth_app_env_id }}_LDAP_GROUPS={{ tinyauth_csv(app.ldap_groups) }}
{% endif %}
{% endfor %}
