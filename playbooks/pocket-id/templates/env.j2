APP_URL=https://{{ pocket_id_hostname }}
ENCRYPTION_KEY_FILE=/run/secrets/pocket_id_encryption_key
TRUST_PROXY={{ pocket_id_trust_proxy | default('172.16.0.0/12') }}
ALLOW_INSECURE_CALLBACK_URLS=false
ANALYTICS_DISABLED=true
UI_CONFIG_DISABLED={{ pocket_id_ui_config_disabled | default(false) | bool | lower }}
PUID=1000
PGID=1000
{% if pocket_id_smtp_enabled | default(false) | bool %}
SMTP_HOST={{ pocket_id_smtp_host }}
SMTP_PORT={{ pocket_id_smtp_port | default('465') }}
SMTP_TLS={{ pocket_id_smtp_tls | default('tls') }}
SMTP_USER={{ pocket_id_smtp_user }}
SMTP_FROM={{ pocket_id_smtp_from }}
SMTP_PASSWORD_FILE={{ pocket_id_smtp_secret_container_path }}
{% endif %}
