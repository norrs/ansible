# Local security rebuild of the three nginx packages used by ruTorrent.
# nginx release signature verified with the key published on nginx.org:
# D6786CE303D9A9022998DC6CC8464D549AF75C0A.
# Module checksums/patches come from Alpine aports commit
# 911125ed67c244f96e675b936e3d06883f0c0c41 (v3.22 stable).
pkgname=nginx
pkgver=1.31.9
pkgrel=0
pkgdesc="nginx security rebuild for the existing ruTorrent image"
url="https://nginx.org"
arch="all"
license="BSD-2-Clause"
makedepends="linux-headers openssl-dev pcre2-dev zlib-dev libmaxminddb-dev libxml2-dev libxslt-dev"
subpackages="$pkgname-mod-http-dav-ext:dav_ext $pkgname-mod-http-geoip2:geoip2"
options="!check"
_aports=911125ed67c244f96e675b936e3d06883f0c0c41
source="
    https://nginx.org/download/nginx-$pkgver.tar.gz
    https://distfiles.alpinelinux.org/distfiles/v3.22/nginx-dav-ext-module-3.0.0.tar.gz
    https://distfiles.alpinelinux.org/distfiles/v3.22/ngx_http_geoip2_module-3.4.tar.gz
    https://raw.githubusercontent.com/alpinelinux/aports/$_aports/main/nginx/nginx-dav-ext-module~dav-class-1-2.patch
    https://raw.githubusercontent.com/alpinelinux/aports/$_aports/main/nginx/nginx-dav-ext-module~fix-profind-fail-on-broken-symlinks.patch
    https://raw.githubusercontent.com/alpinelinux/aports/$_aports/main/nginx/nginx-dav-ext-module~fix-dot-dirs.patch
    "
builddir="$srcdir/nginx-$pkgver"

prepare() {
    local patchfile
    for patchfile in "$srcdir"/nginx-dav-ext-module~*.patch; do
        patch -d "$srcdir/nginx-dav-ext-module-3.0.0" -p1 < "$patchfile"
    done
}

build() {
    # Preserve the installed core HTTP features and path layout. The original
    # image only installs DAV-ext and GeoIP2 dynamic modules; rebuild both
    # against this nginx version rather than loading old, incompatible .so files.
    ./configure \
        --prefix=/var/lib/nginx \
        --sbin-path=/usr/sbin/nginx \
        --modules-path=/usr/lib/nginx/modules \
        --conf-path=/etc/nginx/nginx.conf \
        --pid-path=/run/nginx/nginx.pid \
        --lock-path=/run/nginx/nginx.lock \
        --http-client-body-temp-path=/var/lib/nginx/tmp/client_body \
        --http-proxy-temp-path=/var/lib/nginx/tmp/proxy \
        --http-fastcgi-temp-path=/var/lib/nginx/tmp/fastcgi \
        --http-uwsgi-temp-path=/var/lib/nginx/tmp/uwsgi \
        --http-scgi-temp-path=/var/lib/nginx/tmp/scgi \
        --user=nginx --group=nginx \
        --with-threads --with-file-aio \
        --with-http_ssl_module --with-http_v2_module --with-http_v3_module \
        --with-http_realip_module --with-http_addition_module \
        --with-http_sub_module --with-http_dav_module \
        --with-http_flv_module --with-http_mp4_module \
        --with-http_gunzip_module --with-http_gzip_static_module \
        --with-http_auth_request_module --with-http_random_index_module \
        --with-http_secure_link_module --with-http_degradation_module \
        --with-http_slice_module --with-http_stub_status_module \
        --add-dynamic-module="$srcdir/nginx-dav-ext-module-3.0.0" \
        --add-dynamic-module="$srcdir/ngx_http_geoip2_module-3.4"
    make -j4
}

package() {
    install -Dm755 objs/nginx "$pkgdir/usr/sbin/nginx"
    install -d "$pkgdir/etc/nginx"
    local configfile
    for configfile in fastcgi.conf fastcgi_params mime.types nginx.conf scgi_params uwsgi_params; do
        install -m644 "/original/etc/nginx/$configfile" "$pkgdir/etc/nginx/"
    done
    mkdir -p "$pkgdir/var/lib"
    cp -a /original/var/lib/nginx "$pkgdir/var/lib/"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/nginx/LICENSE"
}

dav_ext() {
    pkgdesc="WebDAV extension built for nginx $pkgver"
    depends="nginx=$pkgver-r$pkgrel"
    install -Dm755 "$builddir/objs/ngx_http_dav_ext_module.so" "$subpkgdir/usr/lib/nginx/modules/ngx_http_dav_ext_module.so"
    install -Dm644 /original/etc/nginx/modules/10_http_dav_ext.conf "$subpkgdir/etc/nginx/modules/10_http_dav_ext.conf"
}

geoip2() {
    pkgdesc="GeoIP2 module built for nginx $pkgver"
    depends="nginx=$pkgver-r$pkgrel"
    install -Dm755 "$builddir/objs/ngx_http_geoip2_module.so" "$subpkgdir/usr/lib/nginx/modules/ngx_http_geoip2_module.so"
    install -Dm644 /original/etc/nginx/modules/10_http_geoip2.conf "$subpkgdir/etc/nginx/modules/10_http_geoip2.conf"
}

