STARTPAGE_BASE_URL=https://{{ start_hostname }}
STARTPAGE_OIDC_ISSUER=https://{{ tinyauth_hostname }}
STARTPAGE_OIDC_CLIENT_ID={{ start_oidc_client_id }}
STARTPAGE_OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret
STARTPAGE_OIDC_SCOPES=openid,profile,email,groups
STARTPAGE_OIDC_LOGOUT_URL=https://{{ tinyauth_hostname }}/logout
STARTPAGE_ADMIN_GROUPS={{ start_admin_group | default('start-admins') }}
STARTPAGE_TRUSTED_PROXIES={{ start_trusted_proxies | default('172.16.0.0/12') }}
STARTPAGE_DATABASE_PATH=/data/start.db
STARTPAGE_SEED_PATH=/app/links.yaml
STARTPAGE_STATIC_DIR=/app/web/dist
STARTPAGE_METRICS_ENABLED=true
STARTPAGE_DEV_MODE=false
STARTPAGE_LOG_LEVEL={{ start_log_level | default('info') }}
